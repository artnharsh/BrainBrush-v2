# ==========================================
# SECRETS TEMPLATE
# ==========================================
# Create this file with real values before deploying:
#   kubectl apply -f k8s/secrets.yaml
#
# To encode values: echo -n "your-value" | base64
# ==========================================
apiVersion: v1
kind: Secret
metadata:
  name: brainbrush-secrets
  labels:
    app: brainbrush
type: Opaque
data:
  jwt-secret: REPLACE_WITH_BASE64_ENCODED_JWT_SECRET
  google-client-id: REPLACE_WITH_BASE64_ENCODED_GOOGLE_CLIENT_ID
  google-client-secret: REPLACE_WITH_BASE64_ENCODED_GOOGLE_CLIENT_SECRET
