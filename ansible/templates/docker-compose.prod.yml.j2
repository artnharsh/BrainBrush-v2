services:

  nginx:
    image: nginx:alpine
    container_name: brainbrush-nginx
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - backend-1
      - backend-2
      - backend-3
    restart: unless-stopped
    mem_limit: 64m

  backend-1:
    image: {{ docker_hub_user }}/brainbrush-backend:{{ docker_image_tag }}
    container_name: brainbrush-backend-1
    restart: unless-stopped
    environment:
      - PORT=5000
      - INSTANCE_ID=backend-1
      - REDIS_URL=redis://redis:6379
      - MONGO_URI={{ mongo_uri }}
      - JWT_SECRET={{ jwt_secret }}
      - GOOGLE_CLIENT_ID={{ google_client_id }}
      - GOOGLE_CLIENT_SECRET={{ google_client_secret }}
      - FRONTEND_URL={{ frontend_url | default('http://localhost') }}
      - ALLOWED_ORIGINS={{ frontend_url | default('http://localhost') }}
      - NODE_OPTIONS=--max-old-space-size=128
    depends_on:
      - redis
    mem_limit: 192m
    networks:
      default:
        aliases:
          - brainbrush-backend

  backend-2:
    image: {{ docker_hub_user }}/brainbrush-backend:{{ docker_image_tag }}
    container_name: brainbrush-backend-2
    restart: unless-stopped
    environment:
      - PORT=5000
      - INSTANCE_ID=backend-2
      - REDIS_URL=redis://redis:6379
      - MONGO_URI={{ mongo_uri }}
      - JWT_SECRET={{ jwt_secret }}
      - GOOGLE_CLIENT_ID={{ google_client_id }}
      - GOOGLE_CLIENT_SECRET={{ google_client_secret }}
      - FRONTEND_URL={{ frontend_url | default('http://localhost') }}
      - ALLOWED_ORIGINS={{ frontend_url | default('http://localhost') }}
      - NODE_OPTIONS=--max-old-space-size=128
    depends_on:
      - redis
    mem_limit: 192m

  backend-3:
    image: {{ docker_hub_user }}/brainbrush-backend:{{ docker_image_tag }}
    container_name: brainbrush-backend-3
    restart: unless-stopped
    environment:
      - PORT=5000
      - INSTANCE_ID=backend-3
      - REDIS_URL=redis://redis:6379
      - MONGO_URI={{ mongo_uri }}
      - JWT_SECRET={{ jwt_secret }}
      - GOOGLE_CLIENT_ID={{ google_client_id }}
      - GOOGLE_CLIENT_SECRET={{ google_client_secret }}
      - FRONTEND_URL={{ frontend_url | default('http://localhost') }}
      - ALLOWED_ORIGINS={{ frontend_url | default('http://localhost') }}
      - NODE_OPTIONS=--max-old-space-size=128
    depends_on:
      - redis
    mem_limit: 192m

  redis:
    image: redis:7-alpine
    container_name: brainbrush-redis
    volumes:
      - redis-data:/data
    command: redis-server --appendonly yes --maxmemory 128mb --maxmemory-policy allkeys-lru
    restart: unless-stopped
    mem_limit: 160m

  frontend:
    image: {{ docker_hub_user }}/brainbrush-frontend:{{ docker_image_tag }}
    container_name: brainbrush-frontend
    restart: unless-stopped
    volumes:
      - ./frontend-nginx.conf:/etc/nginx/conf.d/default.conf:ro
    mem_limit: 64m

volumes:
  redis-data:
    driver: local
